# os-visualizer 后端环境变量样例
# 复制为 .env 后按需修改；所有项都有安全默认值，留空即可运行。

# ---- 鉴权 ----
# 生产部署请显式设置；留空时后端会在 data/jwt_secret.key 生成并持久化随机密钥（权限 600）
OSVIS_JWT_SECRET=
OSVIS_JWT_EXPIRE_MINUTES=10080

# ---- 数据落盘 ----
# OSVIS_DATA_DIR=./data
# OSVIS_MODELS_DIR=./models_cache

# ---- 游客额度（使用服务端默认云端 Key 时生效）----
OSVIS_GUEST_DAILY_CHAT_LIMIT=5

# ---- 服务端默认云端模型（可选，仅在用户未配置任何厂商时兜底）----
# 仅支持 OpenAI 兼容端点。API Key 只存在于后端进程环境，永不返回给前端。
OSVIS_DEFAULT_PROVIDER=deepseek
OSVIS_DEFAULT_MODEL=deepseek-chat
OSVIS_SERVER_API_KEY=
OSVIS_SERVER_BASE_URL=

# ---- 本地部署探测 ----
OSVIS_LOCAL_PROBE_TIMEOUT=2.5

# ---- 内置小模型下载 ----
# 允许下载的主机白名单（防止 SSRF 与任意地址拉取）
OSVIS_DOWNLOAD_ALLOW_HOSTS=huggingface.co,cdn-lfs.huggingface.co,cdn-lfs-us-1.huggingface.co,modelscope.cn,www.modelscope.cn,ollama.com,registry.ollama.ai,github.com,objects.githubusercontent.com

# ---- 跨域 ----
OSVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
